TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE_DOCS=docs
PINECONE_NAMESPACE_CHAT=chat
MAX_FILE_SIZE_MB=20
# Необязательно (значения по умолчанию):
# DOCS_TOP_K=5          — сколько фрагментов документов искать
# MEMORY_TOP_K=5        — сколько сообщений доставать из памяти
# DOCS_MIN_SCORE=0.3    — минимальное косинусное сходство фрагмента
# SUMMARY_CHUNKS=5      — по скольким первым фрагментам писать резюме
